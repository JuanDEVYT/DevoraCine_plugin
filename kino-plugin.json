{
  "id": "devoracine",
  "name": "DevoraCine",
  "version": "1.2.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "icon": "icon.png",
  "hosts": [
    "devoracine.com",
    "vimeus.com",
    "image.tmdb.org"
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "settings": [],
  "theme": {
    "accent": "#78A22F",
    "onAccent": "#0B1407",
    "background": "#0B1407",
    "surface": "#132505",
    "highlight": "#78A22F"
  },
  "description": "DevoraCine para Kino: películas y series en español latino HD.",
  "homepage": "https://devoracine.com/",
  "repo": "JuanDEVYT/DevoraCine_plugin",
  "consent": "Puede reproducir video desde cualquier servidor que indique",
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "DevoraCine",
        "labelEn": "DevoraCine",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir DevoraCine",
          "labelEn": "Open DevoraCine"
        },
        "settingsIn": "screen"
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    }
  }
}
